server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS resolver — required when proxy_pass target is a public/external hostname.
    # Uses Azure DNS (168.63.129.16) with Google (8.8.8.8) as fallback.
    # valid=30s re-resolves the backend hostname every 30 seconds.
    resolver 168.63.129.16 8.8.8.8 valid=30s ipv6=off;

    # --- Compression: shrinks JS/CSS transfer ~3x on the wire ---
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2;

    # Arrows_back API (Superset /api/v1 locations are more specific)
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/;
        proxy_http_version 1.1;
        # Send the backend's own hostname as Host — not the frontend host ($http_host).
        # Sending the frontend host causes the backend to reject the request with 400.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_verify      off;
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }

    location /internal/superset/guest-token {
        proxy_pass http://127.0.0.1:3099;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location = /api/v1/me/roles/ {
        proxy_pass http://127.0.0.1:3099;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location = /static/service-worker.js {
        proxy_pass http://127.0.0.1:3099;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    # Vite build assets must be served as files. Do not fall back to index.html
    # for missing hashed assets, especially the PDF.js worker.
    # Filenames are content-hashed, so they can be cached indefinitely.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # PDF.js v4 ships its worker as .mjs. Some Nginx images do not map this
    # extension correctly, causing browser module-worker load failures.
    location ~* \.mjs$ {
        types {
            application/javascript mjs;
        }
        default_type application/javascript;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Superset embed proxy — Host must match the browser origin (like Vite hostRewrite)
    location /api/v1/ {
        proxy_pass ${SUPERSET_UPSTREAM}/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        include /etc/nginx/snippets/superset-cookie.conf;
        proxy_redirect off;
    }

    location /static/ {
        proxy_pass ${SUPERSET_UPSTREAM}/static/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/superset-cookie.conf;
    }

    location /superset/ {
        proxy_pass ${SUPERSET_UPSTREAM}/superset/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/snippets/superset-cookie.conf;
    }

    # Embedded dashboards use guest JWT via postMessage — do not send admin session cookie
    location /embedded/ {
        proxy_pass ${SUPERSET_UPSTREAM}/embedded/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    location / {
        try_files $uri /index.html;
        # index.html references content-hashed assets; never cache it so new
        # deploys are picked up immediately.
        add_header Cache-Control "no-cache";
    }

    location /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }
}
